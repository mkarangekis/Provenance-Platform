{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/ai/process-next",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/catalog/process-next",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/ai/monitoring-scan",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    }
  }
}
